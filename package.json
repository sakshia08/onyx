    "date-fns": "4.4.0",
    "idb-keyval": "6.3.0",
    "lucide-react": "1.55.0",
    "motion": "14.1.0",
    "radix-ui": "1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
